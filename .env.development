# basePath is intentionally NOT set here: it's only needed in the deployed
# (prod) environment, where the Jenkinsfile sets BASE_HREF / NEXT_PUBLIC_BASE_HREF
# explicitly. Keeping it out of local env files lets `npm run dev` and
# `serve out` work at the root (http://localhost:3001/).

# The browser calls the backend directly (no proxy). The backend enables CORS
# for http://localhost:3001 on the GET endpoints, so this works cross-origin in
# dev. In prod the Jenkinsfile sets this to the gateway URL.
NEXT_PUBLIC_ATOM_API_BASE_URL=http://localhost:8080/atom-synchronizer-dev

# Dev-only JWT for the backend (Authorization: Bearer <jwt>). There is no AFTER
# gateway in dev, so generate a test JWT (jwt.io, per the AFTER procedure) and
# put it in .env.local (gitignored) as NEXT_PUBLIC_DEV_JWT=<jwt>. In prod the
# gateway injects the user's Bearer automatically, so this stays unset there.
# NEXT_PUBLIC_DEV_JWT=
